<?xml version="1.0" encoding="utf-8"?>
<!-- App 启动画面：内置启动图（app_icon）+ 启动中/启动失败提示；主接口 splash 段可覆盖图片/文案/背景色/时长 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B1024">

    <!-- 主接口 splash.image 下发的启动背景图（全屏铺满） -->
    <ImageView
        android:id="@+id/splashBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 背景压暗层：保证标题/提示文字在任意图片上都清晰 -->
    <View
        android:id="@+id/splashDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingRight="48dp">

        <!-- 内置 logo（主接口配置了启动图时隐藏） -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/app_icon" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/splashLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="正在加载配置…"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/splashActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnSplashRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_splash_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="140dp"
                android:paddingLeft="28dp"
                android:paddingTop="12dp"
                android:paddingRight="28dp"
                android:paddingBottom="12dp"
                android:text="重试"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnSplashExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:background="@drawable/bg_splash_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="140dp"
                android:paddingLeft="28dp"
                android:paddingTop="12dp"
                android:paddingRight="28dp"
                android:paddingBottom="12dp"
                android:text="退出"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
