<?xml version="1.0" encoding="utf-8"?>
<!-- 应用市场搜索弹窗 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_market_search_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMarketKeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:background="@drawable/input_search"
            android:hint="@string/app_market_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_20"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textColorHint="@color/color_6CFFFFFF"
            android:textSize="@dimen/ts_24" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_25"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMarketSearch"
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:background="@drawable/button_dialog_vod"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="@string/act_search"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/btnMarketCancel"
                android:layout_width="@dimen/vs_160"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_20"
                android:layout_marginLeft="@dimen/vs_20"
                android:background="@drawable/button_dialog_vod"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="@string/hm_cancel"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
