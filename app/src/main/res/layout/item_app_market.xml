<?xml version="1.0" encoding="utf-8"?>
<!-- 应用市场卡片：图标 / 名称 / 版本 / 大小 / 下载量 / 状态按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_200"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_thumb_radius"
    android:focusable="true"
    android:padding="@dimen/vs_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/vs_10">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_140">

            <ImageView
                android:id="@+id/ivMarketIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/vs_10"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:ellipsize="marquee"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF_70"
            android:textSize="@dimen/ts_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF_70"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/tvDownloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/color_FFFFFF_70"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMarketAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_40"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/vs_8"
            android:background="@drawable/shape_thumb_year"
            android:focusable="false"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_15"
            android:paddingRight="@dimen/vs_15"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
