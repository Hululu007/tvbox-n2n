      "entries": [
        { "name": "点播", "type": "page", "target": "vod", "icon": "hm_vod" },
        { "name": "直播", "type": "page", "target": "live", "icon": "hm_live" },
        { "name": "切换界面", "type": "feature", "target": "screenSwitch", "icon": "hm_settings" }
      ]
    },
    {
      "id": "hotel_showcase_demo",
      "name": "酒店品牌桌面",
      "layout": "hotel_showcase",
